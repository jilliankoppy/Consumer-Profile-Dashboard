{
  "name": "consumer-intelligence-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test src/analysis.test.ts src/extension.test.ts",
    "package:extension": "python3 scripts/package_extension.py",
    "prebuild": "npm run package:extension",
    "predev": "npm run package:extension",
    "test:browser": "node tests/browser.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/d3-force": "^3.0.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "@types/node": "^24.10.0",
    "playwright": "^1.58.2"
  }
}
